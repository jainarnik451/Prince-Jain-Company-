# Copy this file to ".env" (same folder as "app") and fill in the values.
# NEVER upload .env to a public place and never commit it to git.

APP_ENV=production
# Your live website address, no trailing slash
APP_URL=https://www.yourdomain.com
# Only set if the site lives in a sub-folder (e.g. /newsite); otherwise leave blank
APP_BASE_PATH=

# --- Database (create in cPanel -> MySQL Databases) ---
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_pjco
DB_USER=cpaneluser_pjco
DB_PASS=change-me

# --- Security ---
# Long random text (40+ characters). Used to sign forms and anonymise IP addresses.
APP_SECRET=
# One-time key needed to run /install. Long random text. Can be removed after setup.
INSTALL_KEY=
SESSION_NAME=pjco_session

# --- Email notifications (optional) ---
# New enquiries / appointments / feedback are emailed here. Leave blank to turn off.
NOTIFY_EMAIL=pj4@yahoo.com
# Sender address: use an address on YOUR domain so mail is not marked as spam
MAIL_FROM=no-reply@yourdomain.com
